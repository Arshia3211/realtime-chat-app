# ── Server ─────────────────────────────────────
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
# Frontend origin(s) allowed by CORS and Socket.IO (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL= postgres://c84be5208ae08c9b4223f827fe7870d0b84f72b3a16fb8b0a102519f65d99d4d:sk_Hwtqz61R7t8bJZ7cLRm7r@db.prisma.io:5432/postgres?sslmode=require

# ── Auth (JWT) ─────────────────────────────────
# Generate long random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (file/image storage) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (password reset emails) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Realtime Chat <no-reply@example.com>"
